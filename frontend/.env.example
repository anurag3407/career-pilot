# =============================================================================
# CAREER PILOT - FRONTEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit your .env file to version control.
# All variables MUST start with VITE_ to be accessible in the browser.
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND API
# -----------------------------------------------------------------------------

# Base URL of the backend API server
# Type: string (URL)
# Production example: https://api.example.com
VITE_API_URL=http://localhost:5000

# Base URL including /api prefix - used by some service files directly
# Type: string (URL)
VITE_API_BASE=http://localhost:5000/api


# -----------------------------------------------------------------------------
# SUPABASE (DATABASE & AUTHENTICATION)
# -----------------------------------------------------------------------------

# Supabase project URL and anon public key (safe for browser)
# Get from: https://supabase.com/dashboard/project/<project-id>/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key


# -----------------------------------------------------------------------------
# CLERK AUTHENTICATION (ALTERNATIVE / LEGACY)
# -----------------------------------------------------------------------------

# Clerk publishable key (safe for the browser).
# Type: string
# Required for authenticated sessions. If omitted locally, the public marketing
# pages render in preview mode and authenticated routes redirect to /login.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here


# -----------------------------------------------------------------------------
# APPWRITE - CLIENT SDK & STORAGE
# -----------------------------------------------------------------------------

# Appwrite API endpoint
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1

# Appwrite project ID
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id

# Appwrite Storage bucket for user avatars
VITE_APPWRITE_BUCKET_ID=avatars

# Appwrite Database & Collection IDs
VITE_APPWRITE_DATABASE_ID=default_db
VITE_APPWRITE_CHANNELS_COLLECTION_ID=channels
VITE_APPWRITE_MESSAGES_COLLECTION_ID=messages
VITE_APPWRITE_POSTS_COLLECTION_ID=posts
VITE_APPWRITE_COMMENTS_COLLECTION_ID=comments


# -----------------------------------------------------------------------------
# FILE UPLOAD
# -----------------------------------------------------------------------------

# Maximum allowed resume upload size in megabytes
# Type: number
VITE_MAX_SIZE_MB=5
