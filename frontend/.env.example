# =============================================================================
# CAREER PILOT - FRONTEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit your .env file to version control.
# All variables MUST start with VITE_ to be accessible in the browser.
#
# The defaults below work for local development:
#   - vite proxies /gateway -> http://localhost:8787 (worker/ `wrangler dev`)
#   - vite proxies /api     -> http://localhost:5000 (optional Express backend)
# =============================================================================


# -----------------------------------------------------------------------------
# GATEWAY WORKER (auth + D1 data + AI)
# -----------------------------------------------------------------------------

# Base URL used for /auth/*, /db/* and /ai/* calls.
# Local: the vite proxy forwards to http://localhost:8787
# Production: keep "/gateway/v1" (same-origin Worker route) or use an absolute
# Worker URL ending in /gateway/v1 or /v1.
VITE_AI_GATEWAY_URL=/gateway/v1

# Dev-only proxy target for /gateway. vite.config.js reads this from the shell
# environment (not from .env), so export it before `npm run dev` if overriding.
# Default: http://localhost:8787
# VITE_AI_GATEWAY_DEV_URL=http://localhost:8787


# -----------------------------------------------------------------------------
# OPTIONAL EXPRESS BACKEND (PDF, portfolio deploy, community, queues)
# -----------------------------------------------------------------------------

# Backend origin. Leave unset for a Cloudflare-only deployment.
VITE_API_URL=http://localhost:5000

# API prefix used by services/api.js fallbacks (defaults to /api)
VITE_API_BASE=http://localhost:5000/api

# Socket.IO origin (defaults to VITE_API_URL; no connection when unset)
# VITE_SOCKET_URL=http://localhost:5000


# -----------------------------------------------------------------------------
# ASSETS / FEATURE FLAGS
# -----------------------------------------------------------------------------

# Vite base for CDN-hosted assets (default "/")
# VITE_CDN_URL=https://cdn.example.com/

# Set to "true" to render the app in public-preview mode without native auth
# VITE_DISABLE_D1_AUTH=false


# -----------------------------------------------------------------------------
# LEGACY (not required for the D1 core)
# -----------------------------------------------------------------------------
# These are only read by legacy modules/components. Do not use them for new
# work; the live stack uses the gateway Worker + D1.
#
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=
# VITE_APPWRITE_ENDPOINT=
# VITE_APPWRITE_PROJECT_ID=
# VITE_APPWRITE_BUCKET_ID=
# VITE_APPWRITE_DATABASE_ID=
# VITE_APPWRITE_CHANNELS_COLLECTION_ID=
# VITE_APPWRITE_MESSAGES_COLLECTION_ID=
# VITE_APPWRITE_POSTS_COLLECTION_ID=
# VITE_APPWRITE_COMMENTS_COLLECTION_ID=
