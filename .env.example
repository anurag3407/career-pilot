# =============================================================================
# CAREER PILOT - ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Career Pilot consists of two services:
#   1. Frontend (Vite + React) in ./frontend
#   2. Backend (Express + Node.js) in ./backend
#
# Copy this file (or the respective .env.example files) to:
#   - frontend/.env
#   - backend/.env
# =============================================================================


# =============================================================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# =============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database - MongoDB
MONGODB_URI=mongodb://localhost:27017/career-pilot
ENABLE_DB_PROFILING=false

# Supabase (Database & Authentication)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Clerk Authentication (Alternative / Legacy)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Appwrite - Database & Storage
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_API_KEY=your-appwrite-server-api-key

VITE_APPWRITE_DATABASE_ID=default_db
VITE_APPWRITE_CHANNELS_COLLECTION_ID=channels
VITE_APPWRITE_MESSAGES_COLLECTION_ID=messages
VITE_APPWRITE_POSTS_COLLECTION_ID=posts
VITE_APPWRITE_COMMENTS_COLLECTION_ID=comments
VITE_APPWRITE_CONVERSATIONS_COLLECTION_ID=conversations
VITE_APPWRITE_DIRECT_MESSAGES_COLLECTION_ID=directMessages
VITE_APPWRITE_USERS_COLLECTION_ID=users
VITE_APPWRITE_ALERTS_COLLECTION_ID=jobAlerts
VITE_APPWRITE_NOTIFICATIONS_COLLECTION_ID=notificationLogs
VITE_APPWRITE_JOBS_COLLECTION_ID=jobListings

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key
AI_PROVIDER=gemini

# RapidAPI Job Search
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# Email - SMTP / Microservice
EMAIL_USER=no-reply@example.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Redis / BullMQ Job Queue
REDIS_URL=redis://localhost:6379

# Payments - Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Security & Encryption
ENCRYPTION_KEY=your-64-character-hex-encryption-key
TOTP_ENCRYPTION_KEY=your-64-character-hex-totp-encryption-key

# Deployment Integrations (Optional)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
NETLIFY_ACCESS_TOKEN=your_netlify_token
VERCEL_TOKEN=your_vercel_token
GITHUB_TOKEN=your_github_token


# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env)
# =============================================================================

VITE_API_URL=http://localhost:5000
VITE_API_BASE=http://localhost:5000/api
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
VITE_APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-appwrite-project-id
VITE_APPWRITE_BUCKET_ID=avatars
VITE_MAX_SIZE_MB=5
